{
    "name": "mir/headless-cache",
    "type": "typo3-cms-extension",
    "description": "Sync Typo3 page cache invalidations via Webhook",
    "require": {
        "typo3/cms-core": "^14.3",
        "typo3/cms-extbase": "^14.3",
        "typo3/cms-fluid": "^14.3",
        "typo3/cms-frontend": "^14.3",
        "typo3/cms-fluid-styled-content": "^14.3"
    },
    "autoload": {
        "psr-4": {
            "Mir\\HeadlessCache\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mir\\HeadlessCache\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "headless_cache"
        }
    }
}